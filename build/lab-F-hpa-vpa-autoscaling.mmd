flowchart TB
    METRICS["metrics-server"] --> HPAC["HPA controller"]
    METRICS --> VPAR["VPA recommender"]
    subgraph HPA_FLOW["HPA: php-apache (out)"]
        HPAC -->|"CPU over target"| SCALEUP["scaleUp: no window,<br/>double every 15s"]
